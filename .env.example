DATABASE_PATH=./data/catalogue.sqlite
SITE_URL=http://localhost:3000
# Set to true behind production HTTPS. Never use false on a public deployment.
COOKIE_SECURE=false
# Optional public owner information; legal templates require editorial review.
SITE_OPERATOR=
CONTACT_EMAIL=
# Optional Google integrations, read at runtime. Leave empty to disable.
# GA4 measurement ID (G-XXXXXXXXXX): loaded only after the visitor allows analytics.
GA_MEASUREMENT_ID=
# AdSense publisher ID (pub-XXXXXXXXXXXXXXXX): serves /ads.txt and the
# google-adsense-account verification meta tag. No ad script is loaded.
ADSENSE_PUBLISHER_ID=
